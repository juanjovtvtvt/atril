{
  "name": "atril",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite --host",
    "db": "sqlcmd -S localhost\\SQLEXPRESS -E -C -b -i database/atril.sql",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "android": "tsc --noEmit && vite build --mode android && cap sync android && cap open android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "epubjs": "0.3.93",
    "express": "^4.22.3",
    "jszip": "3.10.2",
    "msnodesqlv8": "^6.2.0",
    "mssql": "^11.0.2",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.25",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "1.3.0"
  }
}
